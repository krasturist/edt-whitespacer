<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <extension point="org.eclipse.ui.startup">
      <startup
            class="ru.nechaev.edt.whitespacetrimmer.Startup">
      </startup>
   </extension>

   <extension point="org.eclipse.core.runtime.preferences">
      <initializer
            class="ru.nechaev.edt.whitespacetrimmer.PreferenceInitializer">
      </initializer>
   </extension>

   <extension point="org.eclipse.ui.preferencePages">
      <page
            id="ru.nechaev.edt.whitespacetrimmer.preferences"
            name="EDT Whitespace Trimmer"
            class="ru.nechaev.edt.whitespacetrimmer.TrimmerPreferencePage">
      </page>
   </extension>

</plugin>